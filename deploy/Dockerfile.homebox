# syntax=docker/dockerfile:1@sha256:572cebbc2b15e6f84c077742952674889cb63cd5e9b80abdffcbe587b6f19183
FROM node:22.23.5-alpine3.24@sha256:1314fb30ec37592d5845e5a160d522c0e680972aa534549940b8d73bde88481a AS frontend
ENV NODE_OPTIONS=--max-old-space-size=2048
WORKDIR /src/frontend
COPY frontend/ ./
RUN npm install --global pnpm@10.28.0 \
    && pnpm install --frozen-lockfile --network-concurrency=4 --child-concurrency=2 \
    && pnpm build

FROM golang:1.27.4-alpine3.24@sha256:70bd7ddea8b6cbe5d6943cde279d6b67feb10cc924fb9100d1d8757c1575b280 AS backend
ENV GOTOOLCHAIN=local CGO_ENABLED=0 GOMAXPROCS=2
WORKDIR /src/backend
RUN apk add --no-cache git
COPY backend/go.mod backend/go.sum ./
RUN go mod download
COPY backend/ ./
COPY --from=frontend /src/frontend/.output/public ./app/api/static/public
ARG COMMIT=unknown
ARG VERSION=companion
ARG BUILD_TIME=unknown
RUN --mount=type=cache,target=/root/.cache/go-build \
    go build -p 2 -trimpath -ldflags "-s -w -X main.commit=${COMMIT} -X main.buildTime=${BUILD_TIME} -X main.version=${VERSION}" \
    -o /out/api ./app/api

FROM alpine:3.24.4@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf
ARG COMMIT=unknown
LABEL org.opencontainers.image.source="https://github.com/sysadminsmedia/homebox" \
    org.opencontainers.image.revision="${COMMIT}"
RUN apk add --no-cache ca-certificates wget mosquitto-clients libwebp libavif libheif libjxl \
    && addgroup -g 65532 homebox \
    && adduser -S -u 65532 -G homebox homebox \
    && mkdir -p /data /app \
    && chown 65532:65532 /data /app
ENV HBOX_MODE=production \
    HBOX_STORAGE_CONN_STRING=file:///?no_tmp_dir=true \
    HBOX_STORAGE_PREFIX_PATH=data \
    HBOX_DATABASE_SQLITE_PATH=/data/homebox.db?_pragma=busy_timeout=2000&_pragma=journal_mode=WAL&_fk=1&_time_format=sqlite
WORKDIR /app
COPY --from=backend --chown=65532:65532 /out/api /app/api
USER 65532:65532
EXPOSE 7745
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1:7745/api/v1/status || exit 1
ENTRYPOINT ["/app/api"]
CMD ["/data/config.yml"]
