# Opt-in settings fragment, NOT a complete deployment environment.
# Replace these keys in protected deploy/.env; do not append duplicate keys.
# Keep the original instance ID, secrets, hostnames and selected LAN settings.
# Requires base Compose + external-ai; preserve LAN override when selected.
# Host Ollama must already be container-reachable with this model.
# The example host.docker.internal URLs are for Docker Desktop.
# Native Linux: replace BOTH base URLs with an already container-reachable
# private host IP URL; the stock overlay adds no host alias or mapping.
# If it is loopback-only, stop; see deployment.md before any network change.
AI_CHAT_PROVIDER=ollama
AI_CHAT_BASE_URL=http://host.docker.internal:11434
AI_CHAT_MODEL=minicpm-v4.6
AI_VISION_PROVIDER=ollama
AI_VISION_BASE_URL=http://host.docker.internal:11434
AI_VISION_MODEL=minicpm-v4.6
# Anonymous host endpoint: clear shared AND explicit role key selections.
# This does not delete or change any existing key file.
AI_API_KEY_FILE=
AI_CHAT_API_KEY_FILE=
AI_VISION_API_KEY_FILE=
# Whole-turn budget, including lock waits, repair, inventory reads and state.
ASSISTANT_CHAT_TURN_TIMEOUT_SECONDS=120
