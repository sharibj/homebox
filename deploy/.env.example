# Copy to deploy/.env. Use two DIFFERENT hostnames with DNS pointing to your server.
HOMEBOX_HOST=homebox.home.arpa
ASSISTANT_HOST=inventory.home.arpa
# Generated once by scripts/init-config.sh. Preserve for this inventory's restores.
HOMEBOX_INSTANCE_ID=
# Desktop listeners. Keep loopback when adding the separate Wi-Fi override.
PROXY_BIND_IP=127.0.0.1
# Optional DNS-free Wi-Fi access with docker-compose.lan.yml; keep loopback above.
PROXY_LAN_IP=
# Keep blank normally. The explicit access --listen-all migration sets BOTH
# bind overrides to 0.0.0.0; the advertised/certificate IP above stays exact.
# HTTP port 80 retains PROXY_BIND_IP. Only HTTPS 443/8443 become wildcard.
PROXY_HTTPS_BIND_IP=
PROXY_LAN_BIND_IP=
# internal: install Caddy's local CA on each client. acme: publicly valid DNS + ports.
TLS_ISSUER=internal

# Use a new immutable label whenever the source changes, and retain the old images.
STACK_VERSION=local-4d19c9e4
SOURCE_REVISION=4d19c9e4
HBOX_ALLOW_REGISTRATION=false

# Defaults target a 16 GiB CPU-only machine. Benchmark on the actual server.
OLLAMA_MODEL=qwen3-vl:2b
OLLAMA_CPUS=4
OLLAMA_MEMORY=8g
# Keep 1 unless measured RAM headroom supports retaining two distinct role models.
OLLAMA_MAX_LOADED_MODELS=1

# Native Ollama remains the default; its blank role overrides use OLLAMA_URL/MODEL.
# Provider kinds: ollama, openai-compatible, anthropic-messages, gemini.
AI_PROVIDER=ollama
AI_BASE_URL=
AI_MODEL=
AI_API_KEY_FILE=
# Each role can use its own provider, endpoint, model and server-side key file.
AI_CHAT_PROVIDER=
AI_CHAT_BASE_URL=
AI_CHAT_MODEL=
AI_CHAT_API_KEY_FILE=
AI_VISION_PROVIDER=
AI_VISION_BASE_URL=
AI_VISION_MODEL=
AI_VISION_API_KEY_FILE=
# Endpoints outside bundled Ollama require the deliberate external-ai override.
# Optional keys are files, never environment values. See deployment.md.
# Host Ollama / MiniCPM for BOTH roles: see examples/ollama-minicpm-host.env.
# Replace existing keys, do not append duplicates or replace this complete file.
# URLs below are for Docker Desktop; the stock overlay adds no host mapping.
# Native Linux: replace BOTH URLs with an already container-reachable private host IP.
# Native Linux loopback-only host Ollama is NOT container-reachable; see deployment.md.
# AI_CHAT_PROVIDER=ollama
# AI_CHAT_BASE_URL=http://host.docker.internal:11434
# AI_CHAT_MODEL=minicpm-v4.6
# AI_VISION_PROVIDER=ollama
# AI_VISION_BASE_URL=http://host.docker.internal:11434
# AI_VISION_MODEL=minicpm-v4.6
# AI_API_KEY_FILE=
# AI_CHAT_API_KEY_FILE=
# AI_VISION_API_KEY_FILE=
# ASSISTANT_CHAT_TURN_TIMEOUT_SECONDS=120
# Gemini example (opt-in): provider=gemini, model=gemini-3.1-flash-lite,
# base URL=https://generativelanguage.googleapis.com/v1beta; use a Gemini key.
# Free-tier eligibility/quotas and Google's data-use terms still apply.

# Durable photo jobs keep slow inference outside browser request deadlines.
ASSISTANT_ANALYSIS_QUEUE_LIMIT=8
ASSISTANT_ANALYSIS_QUEUE_TIMEOUT_SECONDS=120
ASSISTANT_ANALYSIS_TIMEOUT_SECONDS=900
ASSISTANT_CAPTURE_SYNC_TIMEOUT_SECONDS=90

# Bounded conversational context. Blank label uses a stable short install ID.
ASSISTANT_CHAT_TURN_TIMEOUT_SECONDS=60
ASSISTANT_CONVERSATION_TTL_SECONDS=1800
ASSISTANT_INSTANCE_LABEL=
