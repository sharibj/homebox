# Copy to deploy/.env. Use two DIFFERENT hostnames with DNS pointing to your server.
HOMEBOX_HOST=homebox.home.arpa
ASSISTANT_HOST=inventory.home.arpa
# Generated once by scripts/init-config.sh. Preserve for this inventory's restores.
HOMEBOX_INSTANCE_ID=
# Safe for local inspection. For phones, set your server's LAN or VPN IPv4 address.
PROXY_BIND_IP=127.0.0.1
# internal: install Caddy's local CA on each client. acme: publicly valid DNS + ports.
TLS_ISSUER=internal

# Use a new immutable label whenever the source changes, and retain the old images.
STACK_VERSION=local-4d19c9e4
SOURCE_REVISION=4d19c9e4
HBOX_ALLOW_REGISTRATION=false

# Defaults target a 16 GiB CPU-only machine. Benchmark on the actual server.
OLLAMA_MODEL=qwen3-vl:2b
OLLAMA_CPUS=4
OLLAMA_MEMORY=8g
