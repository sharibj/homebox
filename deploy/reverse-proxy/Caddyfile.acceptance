# Only for the disposable loopback-only acceptance override.
{
	admin off
	auto_https off
	log {
		level WARN
	}
}

http://localhost:8088 {
	@assistant_api path /api/assistant/v1 /api/assistant/v1/*
	handle @assistant_api {
		header Cache-Control no-store
		request_body {
			max_size 16MB
		}
		reverse_proxy assistant-api:8000
	}
	handle /api/* {
		respond "Not found" 404
	}
	handle {
		reverse_proxy pwa:8080
	}
}

http://localhost:8089 {
	reverse_proxy homebox:7745
}

http://:8081 {
	bind 127.0.0.1
	respond /healthz "ok" 200
}
